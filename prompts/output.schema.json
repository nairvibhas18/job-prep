{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "company",
    "role",
    "base",
    "work",
    "projects",
    "skills"
  ],
  "properties": {
    "company": { "type": "string" },
    "role": { "type": "string" },
    "base": { "enum": ["swe", "mle"] },
    "target_team": { "type": "string" },
    "fit_summary": { "type": "string" },
    "add_new_project": { "type": "boolean" },
    "replaced_bottom_id": { "type": "string" },
    "keep_cut": { "type": "array" },
    "coursework": { "type": "string" },
    "skills": {
      "type": "object",
      "required": ["languages", "developer_tools", "libraries"],
      "properties": {
        "languages": { "type": "string" },
        "developer_tools": { "type": "string" },
        "libraries": { "type": "string" }
      }
    },
    "work": { "type": "array", "minItems": 1 },
    "projects": { "type": "array" },
    "new_project": {
      "type": ["object", "null"],
      "required": ["name", "bullets"],
      "properties": {
        "bullets": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3
        }
      }
    },
    "keyword_map": { "type": "array" }
  }
}
